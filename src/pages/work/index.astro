---
import SiteLayout from '../../layouts/SiteLayout.astro';
import WorkCard from '../../components/WorkCard.astro';
import { projects, site } from '../../components/data';
---
<SiteLayout title="Selected Work" description="Published mobile apps and independent Flutter projects by Yoga Sandhy Winata.">
<main id="main-content" class="inner-page work-page">
  <section class="page-intro page-intro--work"><div class="container"><p class="eyebrow"><i></i> Selected work / {String(projects.length).padStart(2, '0')}</p><h1>Useful apps,<br /><em>made with care.</em></h1><p class="page-lede">A mix of published products and independent builds, each focused on making everyday workflows clearer.</p><div class="page-index"><span>FLUTTER APPLICATIONS</span><strong>{String(projects.length).padStart(2, '0')}</strong></div></div></section>
  <section class="section project-list"><div class="container"><div class="project-list-top"><p class="eyebrow">Flutter applications</p><a class="subtle-link" href={site.github} target="_blank" rel="noreferrer">More on GitHub &#8599;</a></div>
    {projects.map((project, index) => <WorkCard project={project} index={index} />)}
  </div></section>
</main>
</SiteLayout>
