---
import SiteLayout from '../../layouts/SiteLayout.astro';
import WorkCard from '../../components/WorkCard.astro';
import { projects, site } from '../../components/data';
---
<SiteLayout title="Selected Work" titleId="Proyek Pilihan" description="Selected mobile apps, web work, and internship projects by Yoga Sandhy Winata." descriptionId="Pilihan aplikasi mobile, proyek web, dan proyek magang Yoga Sandhy Winata.">
<main id="main-content" class="inner-page work-page">
  <section class="page-intro page-intro--work">
    <div class="container">
      <h1><span data-en="Useful apps," data-id="Aplikasi bermanfaat,">Useful apps,</span><br /><em data-en="made with care." data-id="dibuat dengan perhatian.">made with care.</em></h1>
      <p class="page-lede" data-en="A mix of published apps, active product work, and an internship project adapted for the web." data-id="Kumpulan aplikasi yang telah dirilis, produk yang sedang dikembangkan, dan proyek magang yang diadaptasi untuk web.">A mix of published apps, active product work, and an internship project adapted for the web.</p>
    </div>
  </section>
  <section class="section project-list">
    <div class="container">
      <div class="project-list-top">
        <a class="subtle-link" href={site.github} target="_blank" rel="noreferrer"><span data-en="More on GitHub" data-id="Lihat di GitHub">More on GitHub</span> &#8599;</a>
      </div>
      {projects.map((project) => <WorkCard project={project} />)}
    </div>
  </section>
</main>
</SiteLayout>
