---
import SiteLayout from '../layouts/SiteLayout.astro';
import ProjectScreens from '../components/ProjectScreens.astro';
import { featuredProjects } from '../components/data';
---
<SiteLayout title="Flutter Developer" titleId="Developer Flutter" description="Portfolio of Yoga Sandhy Winata, Flutter developer." descriptionId="Portofolio Yoga Sandhy Winata, developer Flutter.">
<main id="main-content">
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow"><span data-en="Flutter developer" data-id="Developer Flutter">Flutter developer</span></p>
        <h1>Yoga Sandhy<br /><em>Winata</em></h1>
        <p class="hero-lede" data-en="I build mobile apps that help people get things done." data-id="Saya membangun aplikasi mobile yang membantu orang menyelesaikan hal penting dengan lebih mudah.">I build mobile apps that help people get things done.</p>
        <div class="hero-actions">
          <a class="button button--primary" href="/cv-yoga-sandhy-winata.pdf" download="Yoga-Sandhy-Winata-CV.pdf"><span data-en="Download CV" data-id="Unduh CV">Download CV</span> <span aria-hidden="true">&#8595;</span></a>
          <a class="text-link" href="/work/"><span data-en="Explore my work" data-id="Lihat proyek saya">Explore my work</span> <span aria-hidden="true">&#8599;</span></a>
        </div>
      </div>
      <div class="hero-art" aria-hidden="true">
        <div class="hero-art-orbit hero-art-orbit--outer"></div>
        <div class="hero-art-orbit hero-art-orbit--inner"></div>
        <div class="hero-portrait-stage"><img class="hero-portrait" src="/yoga-sandhy-winata.png" alt="" width="977" height="1610" decoding="async" fetchpriority="high" /></div>
      </div>
    </div>
  </section>

  <section id="featured" class="section featured-section">
    <div class="container">
      <div class="section-heading">
        <div><h2><span data-en="Apps with a" data-id="Aplikasi dengan">Apps with a</span><br /><em data-en="job to do." data-id="tujuan jelas.">job to do.</em></h2></div>
        <a class="text-link" href="/work/"><span data-en="See all projects" data-id="Lihat semua proyek">See all projects</span> <span aria-hidden="true">&#8599;</span></a>
      </div>
      <div class="featured-grid">
        {featuredProjects.map((project) => <a class:list={['featured-project', `featured-project--${project.accent}`]} href={`/work/#${project.id}`}>
          <div class="featured-art" aria-hidden="true">
            <div class="featured-art-ring"></div>
            <ProjectScreens project={project} variant="featured" />
            <img class:list={['featured-app-icon', `featured-app-icon--${project.accent}`]} src={project.icon} alt="" loading="lazy" decoding="async" />
          </div>
          <div class="featured-copy">
            <p class="eyebrow"><span data-en={project.type} data-id={project.localized.id.type}>{project.type}</span> <span>{project.platforms.join(' / ')}</span></p>
            <h3>{project.title}</h3>
            <p data-en={project.summary} data-id={project.localized.id.summary}>{project.summary}</p>
            <span class="featured-link"><span data-en="Explore project" data-id="Lihat proyek">Explore project</span> <i aria-hidden="true">&#8594;</i></span>
          </div>
        </a>)}
      </div>
    </div>
  </section>

  <section class="home-note">
    <div class="container note-inner">
      <div><p class="eyebrow" data-en="My approach" data-id="Cara saya bekerja">My approach</p><h2><span data-en="Make the next" data-id="Buat langkah berikutnya">Make the next</span><br /><em data-en="step clear." data-id="jadi jelas.">step clear.</em></h2></div>
      <p class="note-copy" data-en="From reviewing a document to accessing a public service, I focus on clear steps and reliable feedback—so people know what to do and what just happened." data-id="Dari meninjau dokumen hingga mengakses layanan publik, saya mengutamakan alur yang jelas dan respons yang dapat diandalkan—agar orang tahu apa yang perlu dilakukan dan apa yang baru saja terjadi.">From reviewing a document to accessing a public service, I focus on clear steps and reliable feedback—so people know what to do and what just happened.</p>
      <a class="button button--ink" href="/about/"><span data-en="More about me" data-id="Kenali saya">More about me</span> <span aria-hidden="true">&#8599;</span></a>
    </div>
  </section>
</main>
</SiteLayout>
