---
import SiteLayout from '../layouts/SiteLayout.astro';
import { featuredProjects } from '../components/data';
---
<SiteLayout title="Flutter Developer" description="Portfolio of Yoga Sandhy Winata, Flutter developer.">
<main id="main-content">
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow"><i></i> Flutter developer</p>
        <h1>Yoga Sandhy<br /><em>Winata</em></h1>
        <p class="hero-lede">I build mobile apps that help people get things done.</p>
        <div class="hero-actions">
          <a class="button button--primary" href="/cv-yoga-sandhy-winata.pdf" download="Yoga-Sandhy-Winata-CV.pdf">Download CV <span aria-hidden="true">&#8595;</span></a>
          <a class="text-link" href="/work/">Explore my work <span aria-hidden="true">&#8599;</span></a>
        </div>
      </div>
      <div class="hero-art" aria-hidden="true">
        <div class="hero-art-orbit hero-art-orbit--outer"></div>
        <div class="hero-art-orbit hero-art-orbit--inner"></div>
        <div class="hero-portrait-stage"><img class="hero-portrait" src="/yoga-sandhy-winata.png" alt="" width="977" height="1610" decoding="async" fetchpriority="high" /></div>
        <div class="hero-chip hero-chip--one">
          <span class="hero-chip__marks">
            <svg class="hero-chip__icon hero-chip__icon--android" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4.8 9.2a7.2 7.2 0 0 1 14.4 0v.6H4.8v-.6ZM4 11h16v5.8a2 2 0 0 1-2 2h-1V22h-2v-3.2H9V22H7v-3.2H6a2 2 0 0 1-2-2V11Zm-2 0h1.5v5H2v-5Zm18.5 0H22v5h-1.5v-5ZM7 3.3l1.3 2.2-.8.5-1.3-2.2.8-.5Zm10 0 .8.5-1.3 2.2-.8-.5L17 3.3Z"/><circle cx="9" cy="8" r=".7" fill="#fff"/><circle cx="15" cy="8" r=".7" fill="#fff"/></svg>
            <svg class="hero-chip__icon hero-chip__icon--ios" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M16.3 12.7c0-2.1 1.7-3.1 1.8-3.2a3.9 3.9 0 0 0-3.1-1.7c-1.3-.1-2.5.8-3.2.8-.7 0-1.7-.8-2.8-.8a4.2 4.2 0 0 0-3.5 2.1c-1.5 2.6-.4 6.4 1.1 8.5.7 1 1.5 2.1 2.6 2 .9 0 1.3-.6 2.6-.6s1.7.6 2.7.6c1.1 0 1.8-1 2.5-2 .8-1.1 1.1-2.2 1.1-2.3-.1 0-1.8-.7-1.8-3.4ZM14.3 6.5a3.7 3.7 0 0 0 .9-2.7 3.8 3.8 0 0 0-2.5 1.3 3.5 3.5 0 0 0-.9 2.6 3.2 3.2 0 0 0 2.5-1.2Z" /></svg>
          </span>
          <span>Android &amp; iOS</span>
        </div>
        <div class="hero-chip hero-chip--two">
          <svg class="hero-chip__icon hero-chip__icon--flutter" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M14.1 1 3 12.1l3.5 3.5L21.1 1h-7Zm-.2 9.8-5.5 5.5 3.5 3.5 5.5-5.5-3.5-3.5Z" /></svg>
          <span>Flutter + Dart</span>
        </div>
        <div class="hero-chip hero-chip--three">
          <svg class="hero-chip__icon hero-chip__icon--firebase" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M19.455 8.369c-.538-.748-1.778-2.285-3.681-4.569-.826-.991-1.535-1.832-1.884-2.245a146 146 0 0 0-.488-.576l-.207-.245-.113-.133-.022-.032-.01-.005L12.57 0l-.609.488c-1.555 1.246-2.828 2.851-3.681 4.64-.523 1.064-.864 2.105-1.043 3.176-.047.241-.088.489-.121.738-.209-.017-.421-.028-.632-.033-.018-.001-.035-.002-.059-.003a7.46 7.46 0 0 0-2.28.274l-.317.089-.163.286c-.765 1.342-1.198 2.869-1.252 4.416-.07 2.01.477 3.954 1.583 5.625 1.082 1.633 2.61 2.882 4.42 3.611l.236.095.071.025.003-.001a9.59 9.59 0 0 0 2.941.568q.171.006.342.006c1.273 0 2.513-.249 3.69-.742l.008.004.313-.145a9.63 9.63 0 0 0 3.927-3.335c1.01-1.49 1.577-3.234 1.641-5.042.075-2.161-.643-4.304-2.133-6.371m-7.083 6.695c.328 1.244.264 2.44-.191 3.558-1.135-1.12-1.967-2.352-2.475-3.665-.543-1.404-.87-2.74-.974-3.975.48.157.922.366 1.315.622 1.132.737 1.914 1.902 2.325 3.461zm.207 6.022c.482.368.99.712 1.513 1.028-.771.21-1.565.302-2.369.273a8 8 0 0 1-.373-.022c.458-.394.869-.823 1.228-1.279zm1.347-6.431c-.516-1.957-1.527-3.437-3.002-4.398-.647-.421-1.385-.741-2.194-.95.011-.134.026-.268.043-.4.014-.113.03-.216.046-.313.133-.689.332-1.37.589-2.025.099-.25.206-.499.321-.74l.004-.008c.177-.358.376-.719.61-1.105l.092-.152-.003-.001c.544-.851 1.197-1.627 1.942-2.311l.288.341c.672.796 1.304 1.548 1.878 2.237 1.291 1.549 2.966 3.583 3.612 4.48 1.277 1.771 1.893 3.579 1.83 5.375-.049 1.395-.461 2.755-1.195 3.933-.694 1.116-1.661 2.05-2.8 2.708-.636-.318-1.559-.839-2.539-1.599.79-1.575.952-3.28.479-5.072zm-2.575 5.397c-.725.939-1.587 1.55-2.09 1.856-.081-.029-.163-.06-.243-.093l-.065-.026c-1.49-.616-2.747-1.656-3.635-3.01-.907-1.384-1.356-2.993-1.298-4.653.041-1.19.338-2.327.882-3.379.316-.07.638-.114.96-.131l.084-.002c.162-.003.324-.003.478 0 .227.011.454.035.677.07.073 1.513.445 3.145 1.105 4.852.637 1.644 1.694 3.162 3.144 4.515z"/></svg>
          <span>Firebase</span>
        </div>
        <div class="hero-chip hero-chip--four">
          <svg class="hero-chip__icon hero-chip__icon--supabase" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M11.9 1.036c-.015-.986-1.26-1.41-1.874-.637L.764 12.05C-.33 13.427.65 15.455 2.409 15.455h9.579l.113 7.51c.014.985 1.259 1.408 1.873.636l9.262-11.653c1.093-1.375.113-3.403-1.645-3.403h-9.642z"/></svg>
          <span>Supabase</span>
        </div>
      </div>
    </div>
  </section>

  <section id="featured" class="section featured-section">
    <div class="container">
      <div class="section-heading">
        <div><p class="eyebrow">Selected work <span class="count-pill">{String(featuredProjects.length).padStart(2, '0')}</span></p><h2>Apps with a<br /><em>job to do.</em></h2></div>
        <a class="text-link" href="/work/">See all projects <span aria-hidden="true">&#8599;</span></a>
      </div>
      <div class="featured-grid">
        {featuredProjects.map((project, index) => <a class:list={['featured-project', `featured-project--${project.accent}`]} href={`/work/#${project.id}`}>
          <div class="featured-art" aria-hidden="true">
            <div class="featured-art-ring"></div>
            <img class:list={['featured-app-icon', `featured-app-icon--${project.accent}`]} src={project.icon} alt="" loading="lazy" decoding="async" />
            <span class="featured-art-caption">0{index + 1} / MOBILE PRODUCT</span>
          </div>
          <div class="featured-copy">
            <p class="eyebrow">{project.type} <span>{project.platforms.join(' / ')}</span></p>
            <h3>{project.title}</h3>
            <p>{project.summary}</p>
            <span class="featured-link">Explore project <i aria-hidden="true">&#8594;</i></span>
          </div>
        </a>)}
      </div>
    </div>
  </section>

  <section class="home-note">
    <div class="container note-inner">
      <div><p class="eyebrow">My approach</p><h2>Make the next<br /><em>step clear.</em></h2></div>
      <p class="note-copy">From reviewing a document to accessing a public service, I focus on clear steps and reliable feedback—so people know what to do and what just happened.</p>
      <a class="button button--ink" href="/about/">More about me <span aria-hidden="true">&#8599;</span></a>
    </div>
  </section>
</main>
</SiteLayout>
