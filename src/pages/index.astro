---
import SiteLayout from '../layouts/SiteLayout.astro';
import { projects, site } from '../components/data';
---
<SiteLayout title="Flutter Developer" description="Portfolio of Yoga Sandhy Winata, Flutter developer.">
<main id="main-content">
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow"><i></i> Flutter developer <b>/</b> Indonesia</p>
        <h1>Mobile apps,<br />made with <em>purpose.</em></h1>
        <p class="hero-lede">I'm {site.name}. I build thoughtful Flutter applications that make everyday tasks feel easier.</p>
        <div class="hero-actions">
          <a class="button button--primary" href="/work/">Explore my work <span aria-hidden="true">&#8599;</span></a>
          <a class="text-link" href="/about/">Get to know me</a>
        </div>
        <div class="hero-tech" aria-label="Technology and platforms">
          <span class="hero-tech-item">
            <svg class="hero-tech-icon hero-tech-icon--flutter" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M14.1 1 3 12.1l3.5 3.5L21.1 1h-7Zm-.2 9.8-5.5 5.5 3.5 3.5 5.5-5.5-3.5-3.5Z" /></svg>
            Flutter + Dart
          </span>
          <span class="hero-tech-item">
            <svg class="hero-tech-icon hero-tech-icon--android" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4.8 9.2a7.2 7.2 0 0 1 14.4 0v.6H4.8v-.6ZM4 11h16v5.8a2 2 0 0 1-2 2h-1V22h-2v-3.2H9V22H7v-3.2H6a2 2 0 0 1-2-2V11Zm-2 0h1.5v5H2v-5Zm18.5 0H22v5h-1.5v-5ZM7 3.3l1.3 2.2-.8.5-1.3-2.2.8-.5Zm10 0 .8.5-1.3 2.2-.8-.5L17 3.3Z"/><circle cx="9" cy="8" r=".7" fill="#fff"/><circle cx="15" cy="8" r=".7" fill="#fff"/></svg>
            Android
          </span>
          <span class="hero-tech-item">
            <svg class="hero-tech-icon hero-tech-icon--ios" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M16.3 12.7c0-2.1 1.7-3.1 1.8-3.2a3.9 3.9 0 0 0-3.1-1.7c-1.3-.1-2.5.8-3.2.8-.7 0-1.7-.8-2.8-.8a4.2 4.2 0 0 0-3.5 2.1c-1.5 2.6-.4 6.4 1.1 8.5.7 1 1.5 2.1 2.6 2 .9 0 1.3-.6 2.6-.6s1.7.6 2.7.6c1.1 0 1.8-1 2.5-2 .8-1.1 1.1-2.2 1.1-2.3-.1 0-1.8-.7-1.8-3.4ZM14.3 6.5a3.7 3.7 0 0 0 .9-2.7 3.8 3.8 0 0 0-2.5 1.3 3.5 3.5 0 0 0-.9 2.6 3.2 3.2 0 0 0 2.5-1.2Z" /></svg>
            iOS
          </span>
        </div>
        <div class="hero-meta"><span>Based in {site.location}</span></div>
      </div>
      <div class="hero-art" aria-hidden="true">
        <div class="hero-art-orbit hero-art-orbit--outer"></div>
        <div class="hero-art-orbit hero-art-orbit--inner"></div>
        <div class="hero-sun"><span>YSW</span><small>FLUTTER<br />DEVELOPER</small></div>
        <span class="hero-art-note">DESIGN / CODE / CARE</span>
      </div>
    </div>
    <a class="scroll-cue" href="#featured">Scroll to explore <span aria-hidden="true">&#8595;</span></a>
  </section>

  <section id="featured" class="section featured-section">
    <div class="container">
      <div class="section-heading">
        <div><p class="eyebrow">Selected work <span class="count-pill">02</span></p><h2>Apps with a<br /><em>job to do.</em></h2></div>
        <a class="text-link" href="/work/">See both projects <span aria-hidden="true">&#8599;</span></a>
      </div>
      <div class="featured-grid">
        {projects.map((project, index) => <a class:list={['featured-project', `featured-project--${project.accent}`]} href={`/work/#${project.id}`}>
          <div class="featured-art" aria-hidden="true">
            <div class="featured-art-ring"></div>
            <img class:list={['featured-app-icon', `featured-app-icon--${project.accent}`]} src={project.icon} alt="" loading="lazy" decoding="async" />
            <span class="featured-art-caption">0{index + 1} / MOBILE PRODUCT</span>
          </div>
          <div class="featured-copy">
            <p class="eyebrow">{project.type} <span>{project.platforms.join(' / ')}</span></p>
            <h3>{project.title}</h3>
            <p>{project.summary}</p>
            <span class="featured-link">Explore project <i aria-hidden="true">&#8594;</i></span>
          </div>
        </a>)}
      </div>
    </div>
  </section>

  <section class="home-note">
    <div class="container note-inner">
      <div><p class="eyebrow">A little about my approach</p><h2>Thoughtful from<br />first tap to <em>last.</em></h2></div>
      <p class="note-copy">Good mobile software feels natural. I care about clear flows, small details, and building with the people who use the product in mind.</p>
      <a class="button button--ink" href="/about/">More about me <span aria-hidden="true">&#8599;</span></a>
    </div>
  </section>
</main>
</SiteLayout>
