---
import SiteLayout from '../layouts/SiteLayout.astro';
import { education, experience, learningPrograms, site, strengths } from '../components/data';
---
<SiteLayout title="About" titleId="Tentang" description="About Yoga Sandhy Winata, Flutter developer." descriptionId="Tentang Yoga Sandhy Winata, developer Flutter.">
<main id="main-content" class="inner-page about-page">
  <section class="page-intro page-intro--about"><div class="container"><p class="eyebrow"><span data-en="A bit about me" data-id="Tentang saya">A bit about me</span></p><h1><span data-en="Mobile apps," data-id="Aplikasi mobile,">Mobile apps,</span><br /><em data-en="made human." data-id="dibuat untuk manusia.">made human.</em></h1><p class="page-lede" data-en={`I'm ${site.name}, a Flutter developer who enjoys making useful products feel clear, thoughtful, and dependable.`} data-id={`Saya ${site.name}, developer Flutter yang senang membuat produk bermanfaat terasa jelas, matang, dan dapat diandalkan.`}>I'm {site.name}, a Flutter developer who enjoys making useful products feel clear, thoughtful, and dependable.</p><div class="hero-actions cv-actions"><a class="button button--primary" href="/cv-yoga-sandhy-winata.pdf" target="_blank" rel="noreferrer"><span data-en="View CV" data-id="Lihat CV">View CV</span> <span aria-hidden="true">&#8599;</span></a><a class="text-link" href="/cv-yoga-sandhy-winata.pdf" download="Yoga-Sandhy-Winata-CV.pdf" data-en="Download PDF" data-id="Unduh PDF">Download PDF</a></div><div class="page-index"><span data-en="BASED IN" data-id="BERLOKASI DI">BASED IN</span><strong>{site.location}</strong></div></div></section>
  <section class="section experience-section">
    <div class="container">
      <div class="section-heading">
        <div><p class="eyebrow"><span data-en="Experience" data-id="Pengalaman">Experience</span> / {String(experience.length).padStart(2, '0')}</p><h2><span data-en="Building for" data-id="Membangun untuk">Building for</span><br /><em data-en="real use." data-id="kebutuhan nyata.">real use.</em></h2></div>
        <p class="experience-intro" data-en="Product work across public services, digital signatures, and interactive learning experiences." data-id="Pengalaman produk di bidang layanan publik, tanda tangan digital, dan pengalaman belajar interaktif.">Product work across public services, digital signatures, and interactive learning experiences.</p>
      </div>
      <ol class="experience-list">
        {experience.map((item, index) => <li class="experience-item">
          <span class="experience-index">0{index + 1}</span>
          <div><p class="eyebrow" data-en={item.period} data-id={item.periodId}>{item.period}</p><h3 data-en={item.role} data-id={item.localized.role}>{item.role}</h3><p class="experience-organization">{item.organization}</p></div>
          <p class="experience-description" data-en={item.description} data-id={item.localized.description}>{item.description}</p>
        </li>)}
      </ol>
    </div>
  </section>
  <section class="section about-details"><div class="container about-details-grid"><div><p class="eyebrow" data-en="My point of view" data-id="Prinsip saya">My point of view</p><h2><span data-en="Make every tap" data-id="Buat setiap sentuhan">Make every tap</span><br /><span data-en="feel" data-id="terasa">feel</span> <em data-en="considered." data-id="bermakna.">considered.</em></h2></div><div><p class="about-statement" data-en="I care about the details people notice and the ones they don't: a clear flow, responsive feedback, and an app that feels dependable from the first moment." data-id="Saya memperhatikan detail yang terlihat maupun yang sering luput: alur yang jelas, respons yang tepat, dan aplikasi yang terasa dapat diandalkan sejak awal.">I care about the details people notice and the ones they don't: a clear flow, responsive feedback, and an app that feels dependable from the first moment.</p><div class="strength-list">{strengths.map((item, i) => <article><span>0{i + 1}</span><div><h3 data-en={item.title} data-id={item.titleId}>{item.title}</h3><p data-en={item.text} data-id={item.textId}>{item.text}</p></div></article>)}</div></div></div></section>
  <section class="section resume-section">
    <div class="container">
      <div class="section-heading"><div><p class="eyebrow"><span data-en="Education" data-id="Pendidikan">Education</span> / <span data-en="learning" data-id="pembelajaran">learning</span></p><h2><span data-en="Always" data-id="Terus">Always</span> <em data-en="growing." data-id="bertumbuh.">growing.</em></h2></div></div>
      <div class="resume-grid">
        <article class="resume-card">
          <p class="eyebrow" data-en="Education" data-id="Pendidikan">Education</p><h3 data-en={education.degree} data-id={education.localized.degree}>{education.degree}</h3><p class="resume-subtitle">{education.institution}</p>
          <div class="resume-meta"><span data-en={education.period} data-id={education.periodId}>{education.period}</span><strong>GPA {education.gpa}</strong></div>
          <p class="resume-language" data-en={education.languages} data-id={education.localized.languages}>{education.languages}</p>
        </article>
        <article class="resume-card">
          <p class="eyebrow" data-en="Professional development" data-id="Pengembangan profesional">Professional development</p>
          <div class="program-list">
            {learningPrograms.map((program) => <div class="program-item">
              <h4>{program.name} | <span data-en={program.program} data-id={program.localized.program}>{program.program}</span></h4><time data-en={program.period} data-id={program.periodId}>{program.period}</time><p data-en={program.description} data-id={program.localized.description}>{program.description}</p>
            </div>)}
          </div>
        </article>
      </div>
    </div>
  </section>
  <section class="toolkit"><div class="container toolkit-inner"><p class="eyebrow" data-en="Tools I work with" data-id="Teknologi yang saya gunakan">Tools I work with</p><div class="tool-list" role="group" aria-label="Technology stack" data-aria-label-en="Technology stack" data-aria-label-id="Teknologi yang digunakan">
    <span class="tool-logo" role="img" aria-label="Flutter" data-aria-label-en="Flutter" data-aria-label-id="Flutter" title="Flutter"><img src="/tech/flutter.svg" alt="" loading="lazy" decoding="async" /></span>
    <span class="tool-logo" role="img" aria-label="Dart" data-aria-label-en="Dart" data-aria-label-id="Dart" title="Dart"><img src="/tech/dart.svg" alt="" loading="lazy" decoding="async" /></span>
    <span class="tool-logo" role="img" aria-label="Kotlin" data-aria-label-en="Kotlin" data-aria-label-id="Kotlin" title="Kotlin"><img src="/tech/kotlin.svg" alt="" loading="lazy" decoding="async" /></span>
    <span class="tool-logo" role="img" aria-label="Android" data-aria-label-en="Android" data-aria-label-id="Android" title="Android"><img src="/tech/android.svg" alt="" loading="lazy" decoding="async" /></span>
    <span class="tool-logo" role="img" aria-label="Apple" data-aria-label-en="Apple" data-aria-label-id="Apple" title="Apple"><img src="/tech/apple.svg" alt="" loading="lazy" decoding="async" /></span>
    <span class="tool-logo" role="img" aria-label="Firebase" data-aria-label-en="Firebase" data-aria-label-id="Firebase" title="Firebase"><img src="/tech/firebase.svg" alt="" loading="lazy" decoding="async" /></span>
    <span class="tool-logo" role="img" aria-label="Supabase" data-aria-label-en="Supabase" data-aria-label-id="Supabase" title="Supabase"><img src="/tech/supabase.svg" alt="" loading="lazy" decoding="async" /></span>
    <span class="tool-logo" role="img" aria-label="Laravel" data-aria-label-en="Laravel" data-aria-label-id="Laravel" title="Laravel"><img src="/tech/laravel.svg" alt="" loading="lazy" decoding="async" /></span>
    <span class="tool-logo" role="img" aria-label="Git" data-aria-label-en="Git" data-aria-label-id="Git" title="Git"><img src="/tech/git.svg" alt="" loading="lazy" decoding="async" /></span>
  </div></div></section>
</main>
</SiteLayout>
