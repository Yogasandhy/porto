---
import { site } from './data';
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-main">
      <div class="footer-identity">
        <a class="footer-brand" href="/">{site.name}<span data-en={` / ${site.role}`} data-id=" / Developer Flutter"> / {site.role}</span></a>
        <p data-en="Mobile products, built with care." data-id="Produk mobile, dibuat dengan penuh perhatian.">Mobile products, built with care.</p>
      </div>
      <div class="footer-contact">
        <p class="footer-label" data-en="Get in touch" data-id="Hubungi saya">Get in touch</p>
        <a href={`mailto:${site.email}`}><span data-en="Email" data-id="Email">Email</span><strong>{site.email}</strong></a>
        <a href={site.whatsapp} target="_blank" rel="noreferrer"><span data-en="WhatsApp" data-id="WhatsApp">WhatsApp</span><strong>+62 812 6507 3404</strong></a>
      </div>
      <div class="footer-social">
        <p class="footer-label" data-en="Find me online" data-id="Temukan saya">Find me online</p>
        <a href={site.github} target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">&#8599;</span></a>
        <a href={site.linkedin} target="_blank" rel="noreferrer">LinkedIn <span aria-hidden="true">&#8599;</span></a>
      </div>
    </div>
    <div class="footer-bottom"><span>&copy; {new Date().getFullYear()} {site.name}</span><span><span data-en="Flutter Developer" data-id="Developer Flutter">Flutter Developer</span><i></i> Indonesia</span></div>
  </div>
</footer>
