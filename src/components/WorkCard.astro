---
interface Props { project: typeof import('./data').projects[number]; index: number; }
const { project, index } = Astro.props;
const isEsign = project.accent === 'esign';
const isCommunity = project.accent === 'community';
const isExpense = project.accent === 'expense';
---
<article id={project.id} class={`project-card project-card--${project.accent}`}>
  <div class="project-art" aria-hidden="true">
    <span class="art-index">VISUAL STUDY / {String(index + 1).padStart(2, '0')}</span>
    <div class="art-ring art-ring--outer"></div>
    <div class="art-ring art-ring--inner"></div>
    <div class="art-phone">
      <div class="art-island"></div>
      <div class="art-screen">
        <div class="screen-brand">
          <img class="screen-appmark" src={project.icon} alt="" loading="lazy" decoding="async" />
          <span>{project.title}</span>
        </div>
        {isEsign ? (
          <div class="screen-content screen-content--esign">
            <span class="screen-kicker">Nusawork e-Sign · Mobile</span>
            <strong>Digital signatures<br />for business.</strong>
            <div class="screen-document">
              <span class="screen-document-icon">PDF</span>
              <span><b>HR agreement</b><small>Signature + e-Meterai</small></span>
            </div>
            <div class="screen-signature"><span>SIGNATURE / E-METERAI</span><i>Y</i></div>
            <div class="screen-action">Review document <span aria-hidden="true">&#8594;</span></div>
          </div>
        ) : isCommunity ? (
          <div class="screen-content screen-content--community">
            <span class="screen-kicker">Community · report management</span>
            <strong>Every report,<br />in view.</strong>
            <div class="screen-report-panel">
              <span>REPORT OVERVIEW</span>
              <div class="screen-report-row"><i></i>Community reports</div>
              <div class="screen-report-row"><i></i>Updates by status</div>
              <div class="screen-report-row"><i></i>Service totals</div>
            </div>
            <div class="screen-report-action">Review reports <span aria-hidden="true">&#8594;</span></div>
          </div>
        ) : isExpense ? (
          <div class="screen-content screen-content--expense">
            <span class="screen-kicker">Personal finance · daily overview</span>
            <strong>Know where<br />it goes.</strong>
            <div class="screen-finance-panel">
              <span>MONTHLY OVERVIEW</span>
              <div class="screen-finance-row"><i></i>Income overview</div>
              <div class="screen-finance-row"><i></i>Expense history</div>
            </div>
            <div class="screen-finance-categories"><span>Food</span><span>Transport</span><span>More</span></div>
          </div>
        ) : (
          <div class="screen-content screen-content--sumut">
            <span class="screen-kicker">North Sumatra · Public services</span>
            <strong>One portal,<br />for everyone.</strong>
            <div class="screen-services">
              <span><i>+</i>Health</span>
              <span><i>&#9678;</i>Tourism</span>
              <span><i>&#8599;</i>Licensing</span>
            </div>
            <div class="screen-service-note"><b>Vehicle tax · Public reports</b><span>Government info · Local news</span></div>
          </div>
        )}
      </div>
    </div>
    <span class="art-orbit-note">{isEsign ? 'SIGNATURE / E-METERAI / MOBILE' : isCommunity ? 'COMMUNITY REPORTS / SERVICE STATUS' : isExpense ? 'PERSONAL FINANCE / DAILY OVERVIEW' : 'PUBLIC SERVICES / ONE APP'}</span>
  </div>
  <div class="project-copy">
    <div>
      <div class="project-heading">
        <div><p class="eyebrow">{project.type}</p><h3>{project.title}</h3></div>
        <div class="project-meta">
          <span class="project-platforms">{project.platforms.join(' / ')}</span>
          <span class:list={['project-release', { 'project-release--released': project.releaseStatus === 'Released' }]}>{project.releaseStatus}</span>
        </div>
      </div>
      <p class="project-description">{project.description}</p>
    </div>
    <div class="project-bottom">
      <ul class="tag-list">{project.tags.map((tag) => <li>{tag}</li>)}</ul>
      {project.links.length > 0
        ? <div class="store-links">{project.links.map((link) => <a href={link.href} target="_blank" rel="noreferrer" aria-label={link.label} title={link.label}>
          {link.icon === 'google-play' ? (
            <svg class="store-icon store-icon--play" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path fill="#4285F4" d="M4.2 2.6c-.3.2-.5.6-.5 1v16.8c0 .4.2.8.5 1l9-9.4-9-9.4Z" />
              <path fill="#34A853" d="m4.2 2.6 11.1 7.2-2.1 2.2-9-9.4Z" />
              <path fill="#EA4335" d="m4.2 21.4 11.1-7.2-2.1-2.2-9 9.4Z" />
              <path fill="#FBBC04" d="m15.3 9.8 4.1 2.7c.7.4.7 1.1 0 1.5l-4.1 2.7-3.1-4.2 3.1-2.7Z" />
            </svg>
          ) : (
            <svg class="store-icon store-icon--apple" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M16.3 12.7c0-2.1 1.7-3.1 1.8-3.2a3.9 3.9 0 0 0-3.1-1.7c-1.3-.1-2.5.8-3.2.8-.7 0-1.7-.8-2.8-.8a4.2 4.2 0 0 0-3.5 2.1c-1.5 2.6-.4 6.4 1.1 8.5.7 1 1.5 2.1 2.6 2 .9 0 1.3-.6 2.6-.6s1.7.6 2.7.6c1.1 0 1.8-1 2.5-2 .8-1.1 1.1-2.2 1.1-2.3-.1 0-1.8-.7-1.8-3.4ZM14.3 6.5a3.7 3.7 0 0 0 .9-2.7 3.8 3.8 0 0 0-2.5 1.3 3.5 3.5 0 0 0-.9 2.6 3.2 3.2 0 0 0 2.5-1.2Z" />
            </svg>
          )}
        </a>)}</div>
        : project.repository
          ? <a class="project-source-link" href={project.repository} target="_blank" rel="noreferrer">View project on GitHub <span aria-hidden="true">&#8599;</span></a>
          : <span class="project-state">Selected project</span>}
    </div>
  </div>
</article>
