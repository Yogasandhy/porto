---
import ProjectConcept from './ProjectConcept.astro';
interface Props { project: typeof import('./data').projects[number]; index: number; }
const { project, index } = Astro.props;
const isEsign = project.accent === 'esign';
const isCommunity = project.accent === 'community';
const isExpense = project.accent === 'expense';
const conceptKind = project.accent === 'community' || project.accent === 'expense' ? project.accent : null;
const orbitNote = isEsign ? 'SIGNATURE / E-METERAI / MOBILE' : isCommunity ? 'COMMUNITY REPORTS / SERVICE STATUS' : isExpense ? 'PERSONAL FINANCE / DAILY OVERVIEW' : 'PUBLIC SERVICES / ONE APP';
const orbitNoteId = isEsign ? 'TANDA TANGAN / E-METERAI / MOBILE' : isCommunity ? 'LAPORAN WARGA / STATUS LAYANAN' : isExpense ? 'KEUANGAN PRIBADI / RINGKASAN' : 'LAYANAN PUBLIK / SATU APLIKASI';
---
<article id={project.id} class={`project-card project-card--${project.accent}`}>
  {project.gallery?.length ? (
    <div class:list={['project-art', 'project-art--gallery', `project-art--${project.accent}`]}>
      <span class="art-index" data-en={`APP SCREENS / ${String(project.gallery.length).padStart(2, '0')}`} data-id={`TAMPILAN APLIKASI / ${String(project.gallery.length).padStart(2, '0')}`}>APP SCREENS / {String(project.gallery.length).padStart(2, '0')}</span>
      <div class:list={['project-gallery', `project-gallery--${project.gallery.length}`]}>
        {project.gallery.map((image, imageIndex) => <img src={image.src} alt={image.alt} data-en={image.alt} data-id={project.localized.id.galleryAlts?.[imageIndex] ?? image.alt} data-i18n-attribute="alt" loading="lazy" decoding="async" />)}
      </div>
      <span class="art-orbit-note" data-en={`PRODUCT INTERFACE / ${project.platforms.join(' / ')}`} data-id={`ANTARMUKA PRODUK / ${project.platforms.join(' / ')}`}>PRODUCT INTERFACE / {project.platforms.join(' / ')}</span>
    </div>
  ) : conceptKind ? (
    <ProjectConcept kind={conceptKind} />
  ) : (
  <div class={`project-art project-art--${project.accent}`} aria-hidden="true">
    <span class="art-index">VISUAL STUDY / {String(index + 1).padStart(2, '0')}</span>
    <div class="art-ring art-ring--outer"></div>
    <div class="art-ring art-ring--inner"></div>
    <div class="art-phone">
      <div class="art-island"></div>
      <div class="art-screen">
        <div class="screen-brand">
          <img class="screen-appmark" src={project.icon} alt="" loading="lazy" decoding="async" />
          <span>{project.title}</span>
        </div>
        {isEsign ? (
          <div class="screen-content screen-content--esign">
            <span class="screen-kicker" data-en="Nusawork e-Sign · Mobile" data-id="Nusawork e-Sign · Mobile">Nusawork e-Sign · Mobile</span>
            <strong><span data-en="Digital signatures" data-id="Tanda tangan digital">Digital signatures</span><br /><span data-en="for business." data-id="untuk bisnis.">for business.</span></strong>
            <div class="screen-document">
              <span class="screen-document-icon">PDF</span>
              <span><b data-en="HR agreement" data-id="Perjanjian HR">HR agreement</b><small data-en="Signature + e-Meterai" data-id="Tanda tangan + e-Meterai">Signature + e-Meterai</small></span>
            </div>
            <div class="screen-signature"><span data-en="SIGNATURE / E-METERAI" data-id="TANDA TANGAN / E-METERAI">SIGNATURE / E-METERAI</span><i>Y</i></div>
            <div class="screen-action"><span data-en="Review document" data-id="Tinjau dokumen">Review document</span> <span aria-hidden="true">&#8594;</span></div>
          </div>
        ) : isCommunity ? (
          <div class="screen-content screen-content--community">
            <span class="screen-kicker" data-en="Community · report management" data-id="Layanan warga · manajemen laporan">Community · report management</span>
            <strong><span data-en="Every report," data-id="Setiap laporan,">Every report,</span><br /><span data-en="in view." data-id="terpantau.">in view.</span></strong>
            <div class="screen-report-panel">
              <span data-en="REPORT OVERVIEW" data-id="RINGKASAN LAPORAN">REPORT OVERVIEW</span>
              <div class="screen-report-row"><i></i><span data-en="Community reports" data-id="Laporan warga">Community reports</span></div>
              <div class="screen-report-row"><i></i><span data-en="Updates by status" data-id="Pembaruan status">Updates by status</span></div>
              <div class="screen-report-row"><i></i><span data-en="Service totals" data-id="Jumlah layanan">Service totals</span></div>
            </div>
            <div class="screen-report-action"><span data-en="Review reports" data-id="Tinjau laporan">Review reports</span> <span aria-hidden="true">&#8594;</span></div>
          </div>
        ) : isExpense ? (
          <div class="screen-content screen-content--expense">
            <span class="screen-kicker" data-en="Personal finance · daily overview" data-id="Keuangan pribadi · ringkasan harian">Personal finance · daily overview</span>
            <strong><span data-en="Know where" data-id="Ketahui ke mana">Know where</span><br /><span data-en="it goes." data-id="uangmu pergi.">it goes.</span></strong>
            <div class="screen-finance-panel">
              <span data-en="MONTHLY OVERVIEW" data-id="RINGKASAN BULANAN">MONTHLY OVERVIEW</span>
              <div class="screen-finance-row"><i></i><span data-en="Income overview" data-id="Ringkasan pemasukan">Income overview</span></div>
              <div class="screen-finance-row"><i></i><span data-en="Expense history" data-id="Riwayat pengeluaran">Expense history</span></div>
            </div>
            <div class="screen-finance-categories"><span data-en="Food" data-id="Makanan">Food</span><span data-en="Transport" data-id="Transportasi">Transport</span><span data-en="More" data-id="Lainnya">More</span></div>
          </div>
        ) : (
          <div class="screen-content screen-content--sumut">
            <span class="screen-kicker" data-en="North Sumatra · Public services" data-id="Sumatera Utara · Layanan publik">North Sumatra · Public services</span>
            <strong><span data-en="One portal," data-id="Satu portal,">One portal,</span><br /><span data-en="for everyone." data-id="untuk semua.">for everyone.</span></strong>
            <div class="screen-services">
              <span><i>+</i><span data-en="Health" data-id="Kesehatan">Health</span></span>
              <span><i>&#9678;</i><span data-en="Tourism" data-id="Pariwisata">Tourism</span></span>
              <span><i>&#8599;</i><span data-en="Licensing" data-id="Perizinan">Licensing</span></span>
            </div>
            <div class="screen-service-note"><b data-en="Vehicle tax · Public reports" data-id="Pajak kendaraan · Laporan publik">Vehicle tax · Public reports</b><span data-en="Government info · Local news" data-id="Info pemerintah · Berita daerah">Government info · Local news</span></div>
          </div>
        )}
      </div>
    </div>
    <span class="art-orbit-note" data-en={orbitNote} data-id={orbitNoteId}>{orbitNote}</span>
  </div>
  )}
  <div class="project-copy">
    <div>
      <div class="project-heading">
        <div><p class="eyebrow" data-en={project.type} data-id={project.localized.id.type}>{project.type}</p><h3>{project.title}</h3></div>
        <div class="project-meta">
          <span class="project-platforms">{project.platforms.join(' / ')}</span>
          <span class:list={['project-release', { 'project-release--released': project.releaseStatus === 'Released', 'project-release--current': project.releaseStatus === 'In progress' }]} data-en={project.releaseStatus} data-id={project.localized.id.releaseStatus}>{project.releaseStatus}</span>
          {project.contributionLabel && <span class="project-context" data-en={project.contributionLabel} data-id={project.localized.id.contributionLabel}>{project.contributionLabel}</span>}
        </div>
      </div>
      <p class="project-description" data-en={project.description} data-id={project.localized.id.description}>{project.description}</p>
    </div>
    <div class="project-bottom">
      <ul class="tag-list">{project.tags.map((tag, tagIndex) => <li data-en={tag} data-id={project.localized.id.tags[tagIndex] ?? tag}>{tag}</li>)}</ul>
      {project.links.length > 0
        ? <div class="store-links">{project.links.map((link) => <a href={link.href} target="_blank" rel="noreferrer" aria-label={link.label} title={link.label}>
          {link.icon === 'google-play' ? (
            <svg class="store-icon store-icon--play" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path fill="#4285F4" d="M4.2 2.6c-.3.2-.5.6-.5 1v16.8c0 .4.2.8.5 1l9-9.4-9-9.4Z" />
              <path fill="#34A853" d="m4.2 2.6 11.1 7.2-2.1 2.2-9-9.4Z" />
              <path fill="#EA4335" d="m4.2 21.4 11.1-7.2-2.1-2.2-9 9.4Z" />
              <path fill="#FBBC04" d="m15.3 9.8 4.1 2.7c.7.4.7 1.1 0 1.5l-4.1 2.7-3.1-4.2 3.1-2.7Z" />
            </svg>
          ) : (
            <svg class="store-icon store-icon--apple" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M16.3 12.7c0-2.1 1.7-3.1 1.8-3.2a3.9 3.9 0 0 0-3.1-1.7c-1.3-.1-2.5.8-3.2.8-.7 0-1.7-.8-2.8-.8a4.2 4.2 0 0 0-3.5 2.1c-1.5 2.6-.4 6.4 1.1 8.5.7 1 1.5 2.1 2.6 2 .9 0 1.3-.6 2.6-.6s1.7.6 2.7.6c1.1 0 1.8-1 2.5-2 .8-1.1 1.1-2.2 1.1-2.3-.1 0-1.8-.7-1.8-3.4ZM14.3 6.5a3.7 3.7 0 0 0 .9-2.7 3.8 3.8 0 0 0-2.5 1.3 3.5 3.5 0 0 0-.9 2.6 3.2 3.2 0 0 0 2.5-1.2Z" />
            </svg>
          )}
        </a>)}</div>
        : project.repository
          ? <a class="project-source-link" href={project.repository} target="_blank" rel="noreferrer"><span data-en="View project on GitHub" data-id="Lihat proyek di GitHub">View project on GitHub</span> <span aria-hidden="true">&#8599;</span></a>
          : <span class="project-state" data-en="Selected project" data-id="Proyek pilihan">Selected project</span>}
    </div>
  </div>
</article>
